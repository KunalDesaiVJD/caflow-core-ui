# ─────────────────────────────────────────────────────────────────────────────
# CAFlow Tally Sync — Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Tally Settings
TALLY_HOST=localhost
TALLY_PORT=9000

# Supabase Settings (from CAFlow project)
SUPABASE_URL=https://hubyywmodekfdzhwiumb.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# CAFlow IDs (from the CAFlow app — get from browser URL / Settings)
FIRM_ID=YOUR_FIRM_UUID_HERE
CLIENT_ID=YOUR_CLIENT_UUID_HERE
ENGAGEMENT_ID=YOUR_ENGAGEMENT_UUID_HERE

# Sync settings
# Financial year in YYYYMMDD format
FROM_DATE=20240401
TO_DATE=20250331
FINANCIAL_YEAR=2024-25

# Auto-sync interval in minutes (used with "npm run watch")
SYNC_INTERVAL_MINUTES=30

# Tally company name (leave blank to use currently active company)
TALLY_COMPANY=
