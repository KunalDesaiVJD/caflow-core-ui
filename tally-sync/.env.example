# ─────────────────────────────────────────────────────────────────────────────
# CAFlow Tally Sync — Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Tally Server Settings ──────────────────────────────────────────────────
#
# SCENARIO A — Running this agent ON the Tally server PC itself:
#   TALLY_HOST=localhost
#
# SCENARIO B — Running this agent on a node/client PC (LAN setup):
#   TALLY_HOST=192.168.1.10   ← Replace with actual server PC IP
#   (Find server IP: on server PC, open CMD → type: ipconfig → look for IPv4)
#
TALLY_HOST=localhost
TALLY_PORT=9000

# ── Supabase Settings ──────────────────────────────────────────────────────
# Get service_role key from: Supabase Dashboard → Settings → API
# Use SERVICE ROLE key (not anon key) — it bypasses Row Level Security
SUPABASE_URL=https://hubyywmodekfdzhwiumb.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ── CAFlow IDs ─────────────────────────────────────────────────────────────
# Get these from the CAFlow app URL or Settings page
FIRM_ID=YOUR_FIRM_UUID_HERE
CLIENT_ID=YOUR_CLIENT_UUID_HERE
ENGAGEMENT_ID=YOUR_ENGAGEMENT_UUID_HERE

# ── Financial Year ─────────────────────────────────────────────────────────
# Format: YYYYMMDD (8 digits, no dashes)
FROM_DATE=20240401
TO_DATE=20250331
FINANCIAL_YEAR=2024-25

# ── Auto-Sync Interval ─────────────────────────────────────────────────────
# Used only with auto-sync.bat / "npm run watch"
# How often to sync (in minutes). 30 = every 30 minutes.
SYNC_INTERVAL_MINUTES=30

# ── Tally Company Name ─────────────────────────────────────────────────────
# Exact company name as shown in Tally (case sensitive)
# Leave BLANK to use whichever company is currently active in Tally
TALLY_COMPANY=
