# ─────────────────────────────────────────────────────────────────────────────
# Client A — e.g., M/s ABC Pvt Ltd
# Copy this file to clients\ABC.env and fill in values
# Run with: sync-client.bat ABC
# ─────────────────────────────────────────────────────────────────────────────

TALLY_HOST=localhost
TALLY_PORT=9000

# Exact company name as it appears in Tally (Gateway of Tally → Company list)
# Must match EXACTLY — even spacing and case matter
TALLY_COMPANY=M/s ABC Pvt Ltd

SUPABASE_URL=https://hubyywmodekfdzhwiumb.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# CAFlow IDs for THIS client
FIRM_ID=YOUR_FIRM_ID
CLIENT_ID=CLIENT_A_UUID_HERE
ENGAGEMENT_ID=ENGAGEMENT_A_UUID_HERE

# Financial year for this client
FROM_DATE=20240401
TO_DATE=20250331
FINANCIAL_YEAR=2024-25

SYNC_INTERVAL_MINUTES=60
