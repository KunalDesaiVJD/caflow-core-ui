# Copy to .env.local for local development. Never commit real values.

# ── Browser (Vite) — public values only ───────────────────────────────────
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── Server only (Vercel functions in /api) — never prefix with VITE_ ───────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API. Optional fallback key, used only when no key is saved in
# Settings → AI (Supabase Vault). Server only: never prefix it with VITE_.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional. The model chosen in Settings → AI wins; this is used when none is
# chosen there. Default: claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: model used when an edge function asks for "haiku". Default: claude-haiku-5-5.
# ANTHROPIC_MODEL_HAIKU=claude-haiku-5-5

# Shared secret the Supabase Edge Functions send to /api/claude
# (same value as the CLAUDE_CLI_GATEWAY_SECRET Supabase secret).
CLAUDE_CLI_GATEWAY_SECRET=long-random-string
