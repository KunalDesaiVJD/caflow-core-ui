# Copy to .env.local for local development. Never commit real values.

# ── Browser (Vite) — public values only ───────────────────────────────────
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── Server only (Vercel functions in /api) — never prefix with VITE_ ───────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API. Fallback key: a key saved in Settings → AI (Supabase Vault) wins.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model for AI analysis. claude-sonnet-4-5 retires on 30 Nov 2026; set
# claude-sonnet-5-5 (or newer) before then. No redeploy needed after a change
# in Vercel other than the automatic one Vercel offers.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: model used when an edge function asks for "haiku".
# ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5

# Shared secret the Supabase Edge Functions send to /api/claude
# (same value as the CLAUDE_CLI_GATEWAY_SECRET Supabase secret).
CLAUDE_CLI_GATEWAY_SECRET=long-random-string
