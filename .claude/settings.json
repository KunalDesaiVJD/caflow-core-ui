{
  "permissions": {
    "allow": [
      "Bash(npx supabase projects list:*)",
      "Bash(npx supabase link:*)",
      "Bash(npx supabase functions list:*)",
      "Bash(npx supabase functions deploy:*)",
      "Bash(npx supabase migration list:*)",
      "Bash(npx supabase migration repair:*)",
      "Bash(npx supabase db query:*)",
      "Bash(npx supabase secrets list:*)",
      "Bash(npx supabase secrets set:*)"
    ],
    "deny": [
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(npx supabase functions delete:*)",
      "Bash(npx supabase projects delete:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"$d = [Console]::In.ReadToEnd() | ConvertFrom-Json; $cmd = $d.tool_input.command; if ($cmd -match 'git commit|git merge') { Set-Location 'C:/Users/Admin/OneDrive/Documents/GitHub/caflow-core-ui'; $branch = git rev-parse --abbrev-ref HEAD 2>$null; if ($branch -and $branch -ne 'HEAD') { git push origin $branch 2>&1 | Out-Null } }\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Pushing to GitHub..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"C:/Users/Admin/OneDrive/Documents/GitHub/caflow-core-ui/.claude/hooks/session-end.ps1\"",
            "timeout": 60,
            "statusMessage": "Merging session branch and pushing to GitHub..."
          }
        ]
      }
    ]
  }
}
